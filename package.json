{
  "name": "vinculum",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "bun scripts/build-math-wasm.ts",
    "test:rust": "cargo test --locked -p vinculum-math-core",
    "dev": "bun run build:wasm && bun run prepare:math && bun run --filter @vinculum/graph dev",
    "build": "bun run build:wasm && bun run prepare:math && bun run --filter @vinculum/graph build",
    "lint": "bun run --filter @vinculum/graph lint",
    "typecheck": "bun run --filter @vinculum/graph typecheck",
    "test": "bun run --filter @vinculum/graph test",
    "test:e2e": "bun run --filter @vinculum/graph test:e2e",
    "test:e2e:all-browsers": "bun run --filter @vinculum/graph test:e2e:all-browsers",
    "prepare:math": "bun scripts/prepare-math-assets.ts",
    "video:dev": "bun run --filter @vinculum/video dev",
    "video:build": "bun run --filter @vinculum/video build",
    "video:build:vertical": "bun run --filter @vinculum/video build:vertical"
  }
}
