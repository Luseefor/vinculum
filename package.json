{
  "name": "vinculum",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "bun scripts/build-math-wasm.ts",
    "test:rust": "cargo test --locked -p vinculum-math-core",
    "dev": "bun run --filter @vinculum/graph dev",
    "build": "bun run --filter @vinculum/graph build",
    "lint": "bun run --filter @vinculum/graph lint",
    "typecheck": "bun run --filter @vinculum/graph typecheck",
    "test": "bun run --filter @vinculum/graph test",
    "test:e2e": "bun run --filter @vinculum/graph test:e2e",
    "test:e2e:all-browsers": "bun run --filter @vinculum/graph test:e2e:all-browsers"
  }
}
