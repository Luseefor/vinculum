# Vinculum Environment Variables
# Copy this file to .env.local and fill in the values

# PostHog Analytics (optional)
# If not set, analytics will be disabled and no data will be sent
# Get your key from PostHog project settings (not a personal API key)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Site URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
