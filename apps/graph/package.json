    "three": "^0.164.1",
    "three-stdlib": "^2.36.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.164.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.3",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.17",
    "jsdom": "^29.0.2",
